# Copy to .env and fill in. .env is gitignored; this template is not.
#
#   cp .env.example .env
#
# Real environment variables take precedence over anything set here.

# --- Model + embedding providers (required) ---
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# --- Langfuse tracing (optional) ---
# Leave these blank to run untraced. If they are set but wrong, startup prints a
# loud warning and disables tracing, and evals/run_eval.py refuses to start -
# that is deliberate, so a long eval never again finishes with no traces.
#
# The secret is shown ONCE when you create the key in the Langfuse UI
# (project -> Settings -> API Keys). It is stored only as a hash, so if you lose
# it you must issue a new pair rather than look it up.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# --- Retrieval knobs (optional; defaults live in ask.py) ---
# TOP_K=14
# RETRIEVAL_STRATEGY=vanilla

# --- serve.py (optional) ---
# When set, every /ask request must send a matching X-API-Key header.
# RAG_API_KEY=
